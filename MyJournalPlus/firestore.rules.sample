rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /entries/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /moods/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /devices/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /aiChats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /messages/{msgId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
